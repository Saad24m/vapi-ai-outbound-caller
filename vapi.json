      "name": "Sticky Note4"
    },
    {
      "parameters": {
        "jsCode": "let argsRaw = $input.first().json.body.message.artifact.messages[5].toolCalls[0].function.arguments;\n\n// Parse if string\nlet args;\ntry {\n  args = typeof argsRaw === 'string' ? JSON.parse(argsRaw) : argsRaw;\n} catch (err) {\n  args = {};\n}\n\nconst isoString = args.callBackTime;\nlet formatted = null;\n\nif (isoString) {\n  // Instead of parsing as Date (which auto-converts timezone),\n  // manually extract parts to preserve the exact hour/minute\n  const [datePart, timePart] = isoString.split('T');\n  const [year, month, day] = datePart.split('-');\n  const [hour, minute] = timePart.replace('Z', '').split(':');\n\n  const displayDate = new Date(Date.UTC(year, month - 1, day, hour, minute));\n\n  formatted = new Intl.DateTimeFormat('en-US', {\n    timeZone: 'UTC', // 👈 Important — don’t shift time\n    month: '2-digit',\n    day: '2-digit',\n    year: 'numeric',\n    hour: '2-digit',\n    minute: '2-digit',\n    hour12: true\n  }).format(displayDate);\n}\n\nreturn {\n  callback_time_formatted: formatted || 'Invalid or missing date'\n};\n"
      },
